+// Sorting is private to the offline candidate vector.
+template<class Key, class Compare>
+void sortKeys(std::vector<Key>& a, Compare compare) {
+    if (std::is_sorted(a.begin(), a.end(), compare))
+        return;
+    if (std::is_sorted(a.begin(), a.end(), [&](const Key& x, const Key& y) {
