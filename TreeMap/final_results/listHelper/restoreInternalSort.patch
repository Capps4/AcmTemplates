+    constexpr bool descending = std::is_same_v<Compare, std::greater<Key>> ||
+                                std::is_same_v<Compare, std::greater<>>;
+    if constexpr (std::is_integral_v<Key> && !std::is_same_v<Key, bool> &&
+                  (ascending || descending)) {
+        const size_t n = a.size();
+        int logN = 0;
+        for (size_t size = n; size > 1; size >>= 1)
+            ++logN;
+        const double sortWork = double(n) * logN;
+        if (sortWork > 2.0 * n + 256) {
+            using Unsigned = std::make_unsigned_t<Key>;
+            auto bounds = std::minmax_element(a.begin(), a.end());
+            Unsigned minValue = static_cast<Unsigned>(*bounds.first);
+            Unsigned range = static_cast<Unsigned>(*bounds.second) - minValue;
+            int bits = 0;
+            for (Unsigned value = range; value; value >>= 1)
