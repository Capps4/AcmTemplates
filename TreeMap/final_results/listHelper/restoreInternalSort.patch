+            auto radixSort = [&](auto wide) {
+                constexpr int B = decltype(wide)::value ? 11 : 8;
+                constexpr unsigned buckets = 1u << B, mask = buckets - 1;
+                std::vector<Key> buffer(a.size());
+                std::vector<size_t> positions(buckets);
+                for (int shift = 0; range; shift += B) {
+                    auto digit = [&](Key value) {
+                        Unsigned key = static_cast<Unsigned>(value) - minValue;
+                        unsigned index = (key >> shift) & mask;
+                        return descending ? index ^ mask : index;
+                    };
+                    std::fill(positions.begin(), positions.end(), 0);
+                    for (Key value : a)
+                        ++positions[digit(value)];
+                    if (positions[digit(a.front())] != a.size()) {
+                        std::exclusive_scan(positions.begin(), positions.end(), positions.begin(), size_t{0});
+                        for (Key value : a)
