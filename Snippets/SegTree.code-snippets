{
    "Print to console": {
        "scope": "cpp",
        "prefix": "_T_SegTree",
        "body": [
            "namespace _segt {",
            "template <class Tag>",
            "struct Tags {",
            "    std::vector<Tag> tag{};",
            "};",
            "",
            "template <>",
            "struct Tags<void> {};",
            "}",
            "",
            "template <class Info, class Tag = void>",
            "class SegTree : private _segt::Tags<Tag> {",
            "    static constexpr bool hasTag = !std::is_void_v<Tag>;",
            "    static constexpr int maxDepth = std::numeric_limits<int>::digits;",
            "    int n = 0, base = 1, height = 0;",
            "    std::vector<Info> info{};",
            "",
            "    // h is the distance to the leaf layer; ignore padding on the right.",
            "    void up(int p, int h) {",
            "        if (((p * 2 + 1) << (h - 1)) < base + n)",
            "            info[p] = info[p * 2] + info[p * 2 + 1];",
            "        else",
            "            info[p] = info[p * 2];",
            "    }",
            "",
            "    template <class U>",
            "    void apply(int p, const U &v) {",
            "        info[p].apply(v);",
            "        if (p < base) this->tag[p].apply(v);",
            "    }",
            "",
            "    void down(int p) {",
            "        if constexpr (hasTag) {",
            "            apply(p * 2, this->tag[p]);",
            "            apply(p * 2 + 1, this->tag[p]);",
            "            this->tag[p] = Tag();",
            "        }",
            "    }",
            "",
            "    void push(int p) {",
            "        if constexpr (hasTag)",
            "            for (int h = height; h; --h) down(p >> h);",
            "    }",
            "",
            "    void push(int l, int r) {",
            "        if constexpr (hasTag) {",
            "            for (int h = height; h; --h) {",
            "                if (((l >> h) << h) != l) down(l >> h);",
            "                if (((r >> h) << h) != r) down((r - 1) >> h);",
            "            }",
            "        }",
            "    }",
            "",
            "    template <class F>",
            "    std::optional<int> find(int p, F &pred, bool last) {",
            "        std::array<int, maxDepth> stk{};",
            "        int cnt = 0;",
            "        while (true) {",
            "            if (pred(info[p])) {",
            "                if (p >= base) return p - base;",
            "                down(p);",
            "                p = p * 2 + int(last);",
            "                stk[cnt++] = p ^ 1;",
            "            } else {",
            "                if (!cnt) return std::nullopt;",
            "                p = stk[--cnt];",
            "            }",
            "        }",
            "    }",
            "",
            "public:",
            "    template <class G>",
            "    explicit SegTree(const std::vector<G> &a) {",
            "        n = static_cast<int>(a.size());",
            "        if (!n) return;",
            "        while (base < n) { base *= 2; ++height; }",
            "        info.assign(static_cast<std::size_t>(base) * 2, Info(a[0]));",
            "        if constexpr (hasTag) this->tag.assign(base, Tag());",
            "        for (int i = 0; i < n; ++i) info[base + i] = Info(a[i]);",
            "        for (int h = 1; h <= height; ++h)",
            "            for (int p = base >> h; p <= ((base + n - 1) >> h); ++p) up(p, h);",
            "    }",
            "",
            "    SegTree(int n, const Info &leaf) : SegTree(std::vector<Info>(n, leaf)) {}",
            "",
            "    void modify(int p, const Info &v) {",
            "        assert(0 <= p && p < n);",
            "        p += base;",
            "        push(p);",
            "        info[p] = v;",
            "        for (int h = 1; p > 1; ++h) { p >>= 1; up(p, h); }",
            "    }",
            "",
            "    // All intervals are [l, r).",
            "    Info query(int l, int r) {",
            "        assert(0 <= l && l < r && r <= n);",
            "        l += base; r += base;",
            "        push(l, r);",
            "        std::optional<Info> left, right;",
            "        while (l < r) {",
            "            if (l & 1) { left = left ? *left + info[l] : info[l]; ++l; }",
            "            if (r & 1) { --r; right = right ? info[r] + *right : info[r]; }",
            "            l >>= 1; r >>= 1;",
            "        }",
            "        if (!left) return *right;",
            "        if (!right) return *left;",
            "        return *left + *right;",
            "    }",
            "",
            "    // U must equal Tag, so deduction cannot enable updates for Tag=void.",
            "    template <class U = Tag,",
            "              std::enable_if_t<!std::is_void_v<U> && std::is_same_v<U, Tag>, int> = 0>",
            "    void modify(int l, int r, const U &v) {",
            "        assert(0 <= l && l <= r && r <= n);",
            "        if (l == r) return;",
            "        l += base; r += base;",
            "        push(l, r);",
            "        int left = l, right = r;",
            "        while (l < r) {",
            "            if (l & 1) apply(l++, v);",
            "            if (r & 1) apply(--r, v);",
            "            l >>= 1; r >>= 1;",
            "        }",
            "        // Fully covered nodes retain their newly applied tags.",
            "        for (int h = 1; h <= height; ++h) {",
            "            if (((left >> h) << h) != left) up(left >> h, h);",
            "            if (((right >> h) << h) != right) up((right - 1) >> h, h);",
            "        }",
            "    }",
            "",
            "    // A false predicate must rule out every matching leaf in that node.",
            "    template <class F>",
            "    std::optional<int> first(int l, int r, F pred) {",
            "        assert(0 <= l && l <= r && r <= n);",
            "        if (l == r) return std::nullopt;",
            "        l += base; r += base;",
            "        push(l, r);",
            "        std::array<int, maxDepth> stk{};",
            "        int cnt = 0;",
            "        while (l < r) {",
            "            if (l & 1) {",
            "                auto ans = find(l++, pred, false);",
            "                if (ans) return ans;",
            "            }",
            "            if (r & 1) stk[cnt++] = --r;",
            "            l >>= 1; r >>= 1;",
            "        }",
            "        while (cnt) {",
            "            auto ans = find(stk[--cnt], pred, false);",
            "            if (ans) return ans;",
            "        }",
            "        return std::nullopt;",
            "    }",
            "",
            "    template <class F>",
            "    std::optional<int> last(int l, int r, F pred) {",
            "        assert(0 <= l && l <= r && r <= n);",
            "        if (l == r) return std::nullopt;",
            "        l += base; r += base;",
            "        push(l, r);",
            "        std::array<int, maxDepth> stk{};",
            "        int cnt = 0;",
            "        while (l < r) {",
            "            if (l & 1) stk[cnt++] = l++;",
            "            if (r & 1) {",
            "                auto ans = find(--r, pred, true);",
            "                if (ans) return ans;",
            "            }",
            "            l >>= 1; r >>= 1;",
            "        }",
            "        while (cnt) {",
            "            auto ans = find(stk[--cnt], pred, true);",
            "            if (ans) return ans;",
            "        }",
            "        return std::nullopt;",
            "    }",
            "};",
            "",
            "// replace me: range add and range sum.",
            "struct Tag {",
            "    long long add = 0;",
            "",
            "    void apply(const Tag &v) {",
            "        add += v.add;",
            "    }",
            "};",
            "",
            "struct Info {",
            "    long long val;",
            "    int len;",
            "",
            "    explicit Info(long long val = 0, int len = 1)",
            "        : val(val), len(len) {}",
            "",
            "    Info operator+(const Info &v) const {",
            "        return Info(val + v.val, len + v.len);",
            "    }",
            "",
            "    void apply(const Tag &v) {",
            "        val += v.add * len;",
            "    }",
            "};",
            "$0"
