            "            ans += ps[a].triple(ps[b], ps[c]);",
            "        }",
            "        return ans;",
            "    }",
            "",
            "    Real vol() const {",
            "        Real ans(vol6());",
            "        if (ans < 0) ans = -ans;",
            "        return ans / 6;",
            "    }",
            "",
            "    // 反转所有三角面的方向。",
            "    void reverse() {",
            "        for (auto i = 0U; i < fs.size(); i++)",
            "            std::swap(fs[i].b, fs[i].c);",
            "    }",
            "};",
